// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "edit_predictions": {
    "provider": "copilot"
  },
  "context_servers": {
    "mcp-server-context7": {
      "enabled": false,
      "settings": {}
    }
  },
  "agent_servers": {
    "claude": {
      "default_mode": "plan"
    }
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "prettier": {
    "allowed": false
  },
  "ssh_connections": [
    {
      "host": "github",
      "projects": []
    },
    {
      "host": "HOSTNAME",
      "projects": []
    }
  ],
  "agent": {
    "model_parameters": [],
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1"
    }
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false
  },
  "buffer_font_family": "mononoki",
  "autosave": {
    "after_delay": {
      "milliseconds": 500
    }
  },
  "tab_bar": {
    // "show": false
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
    "show_diagnostics": "all"
  },
  "icon_theme": "Catppuccin Mocha",
  "telemetry": {
    "metrics": false,
    "diagnostics": false
  },
  "base_keymap": "VSCode",
  "vim_mode": true,
  "ui_font_size": 15,
  "buffer_font_size": 17,
  "buffer_line_height": {
    "custom": 2
  },
  "lsp": {
    "golangci-lint": {
      "initialization_options": {
        "command": [
          "golangci-lint",
          "run",
          "--output.json.path",
          "stdout",
          "--show-stats=false",
          "--output.text.path="
        ]
      }
    },
    "gopls": {
      "initialization_options": {
        "gofumpt": true,
        "buildFlags": [
          "-tags=unit,integration"
        ]
      }
    }
  },
  "languages": {
    "Go": {
      "hard_tabs": false,
      "formatter": {
        "language_server": {
          "name": "gopls"
        }
      },
      "language_servers": [
        "gopls",
        "golangci-lint"
      ]
    },
    "TypeScript": {
      "formatter": "prettier"
    },
    "JavaScript": {
      "formatter": "prettier"
    }
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Mocha - No Italics"
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": false
    },
    "dock": "bottom"
  },
  "which_key": {
    "delay_ms": 20,
    "enabled": true
  }
}
